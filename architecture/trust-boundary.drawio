<mxfile host="app.diagrams.net"><diagram id="trust-boundary" name="Trust boundary"><mxGraphModel dx="1064.0" dy="1456.0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1064.0" pageHeight="1456.0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="Mỗi mũi tên cắt qua đường đứt là một trust boundary cần bằng chứng" style="text;html=1;whiteSpace=nowrap;fillColor=none;strokeColor=none;fontColor=#000000;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="33.6" y="25.2" width="980.0" height="30.8" as="geometry"/></mxCell><mxCell id="v2" value="Khung đứt nét đỏ = một vùng tin cậy · nhãn TB = chỗ vượt ranh giới, khớp với bảng trust boundary trong báo cáo" style="text;html=1;whiteSpace=nowrap;fillColor=none;strokeColor=none;fontColor=#555555;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="33.6" y="61.6" width="980.0" height="25.2" as="geometry"/></mxCell><mxCell id="zInternet" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="33.6" y="106.4" width="996.8" height="145.6" as="geometry"/></mxCell><mxCell id="v3" value="Internet — không tin cậy" style="text;html=1;whiteSpace=nowrap;fillColor=none;strokeColor=none;fontColor=#b85450;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50.4" y="114.8" width="504.0" height="30.8" as="geometry"/></mxCell><mxCell id="zGateway" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="33.6" y="330.4" width="604.8" height="190.4" as="geometry"/></mxCell><mxCell id="v4" value="Gateway (PEP)" style="text;html=1;whiteSpace=nowrap;fillColor=none;strokeColor=none;fontColor=#b85450;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50.4" y="338.8" width="504.0" height="30.8" as="geometry"/></mxCell><mxCell id="zIdentity" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="716.8" y="330.4" width="313.6" height="190.4" as="geometry"/></mxCell><mxCell id="v5" value="Identity (IdP)" style="text;html=1;whiteSpace=nowrap;fillColor=none;strokeColor=none;fontColor=#b85450;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="733.6" y="338.8" width="504.0" height="30.8" as="geometry"/></mxCell><mxCell id="zBackend" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="33.6" y="588.0" width="604.8" height="196.0" as="geometry"/></mxCell><mxCell id="v6" value="Backend nội bộ" style="text;html=1;whiteSpace=nowrap;fillColor=none;strokeColor=none;fontColor=#b85450;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50.4" y="596.4" width="504.0" height="30.8" as="geometry"/></mxCell><mxCell id="zPolicy" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="716.8" y="588.0" width="313.6" height="196.0" as="geometry"/></mxCell><mxCell id="v7" value="Policy (PDP)" style="text;html=1;whiteSpace=nowrap;fillColor=none;strokeColor=none;fontColor=#b85450;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="733.6" y="596.4" width="504.0" height="30.8" as="geometry"/></mxCell><mxCell id="zSiem" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="33.6" y="862.4" width="604.8" height="313.6" as="geometry"/></mxCell><mxCell id="v8" value="Telemetry / SIEM" style="text;html=1;whiteSpace=nowrap;fillColor=none;strokeColor=none;fontColor=#b85450;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50.4" y="870.8" width="504.0" height="30.8" as="geometry"/></mxCell><mxCell id="zKms" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="716.8" y="1008.0" width="313.6" height="168.0" as="geometry"/></mxCell><mxCell id="v9" value="KMS" style="text;html=1;whiteSpace=nowrap;fillColor=none;strokeColor=none;fontColor=#b85450;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="733.6" y="1016.4" width="504.0" height="30.8" as="geometry"/></mxCell><mxCell id="zControl" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="33.6" y="1254.4" width="996.8" height="168.0" as="geometry"/></mxCell><mxCell id="v10" value="Control / Admin — nắm là nắm tất cả" style="text;html=1;whiteSpace=nowrap;fillColor=none;strokeColor=none;fontColor=#b85450;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50.4" y="1262.8" width="504.0" height="30.8" as="geometry"/></mxCell><mxCell id="client" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Client: SPA / CLI · batch-worker&lt;/b&gt;&lt;br&gt;máy của người dùng, ta không kiểm soát · giữ access token và khoá riêng DPoP" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="56.0" y="151.2" width="952.0" height="78.4" as="geometry"/></mxCell><mxCell id="envoy" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Envoy&lt;/b&gt;&lt;br&gt;TLS 1.3 · jwt_authn (P0)&lt;br&gt;gọi auth-svc (ext_authz)&lt;br&gt;xoá header X-User giả" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="56.0" y="375.2" width="257.6" height="123.2" as="geometry"/></mxCell><mxCell id="auth" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;auth-svc (Go)&lt;/b&gt;&lt;br&gt;kiểm JWT: alg/iss/aud/exp&lt;br&gt;kiểm DPoP proof + jti&lt;br&gt;hỏi OPA · lỗi thì chặn" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="358.4" y="375.2" width="257.6" height="123.2" as="geometry"/></mxCell><mxCell id="kc" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Keycloak&lt;/b&gt;&lt;br&gt;đăng nhập, PKCE, cấp token&lt;br&gt;ký JWT · công bố JWKS&lt;br&gt;admin console: chỉ nội bộ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="739.2" y="375.2" width="268.8" height="123.2" as="geometry"/></mxCell><mxCell id="orders" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;orders-api&lt;/b&gt;&lt;br&gt;chỉ nhận request từ Envoy&lt;br&gt;kiểm chủ đơn hàng (BOLA)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="56.0" y="632.8" width="257.6" height="100.8" as="geometry"/></mxCell><mxCell id="profile" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;profile-api&lt;/b&gt;&lt;br&gt;chỉ nhận request từ Envoy&lt;br&gt;kiểm quyền admin (BFLA)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="358.4" y="632.8" width="257.6" height="100.8" as="geometry"/></mxCell><mxCell id="opa" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;OPA / Rego&lt;/b&gt;&lt;br&gt;trả lời allow / deny&lt;br&gt;policy đọc từ file .rego" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="739.2" y="632.8" width="268.8" height="100.8" as="geometry"/></mxCell><mxCell id="vector" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Vector&lt;/b&gt;&lt;br&gt;HMAC giả danh user_id&lt;br&gt;nối hash chain SHA-256" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="56.0" y="907.2" width="257.6" height="100.8" as="geometry"/></mxCell><mxCell id="os" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;OpenSearch&lt;/b&gt;&lt;br&gt;lưu và tìm kiếm log&lt;br&gt;Dashboards: chỉ nội bộ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="358.4" y="907.2" width="257.6" height="100.8" as="geometry"/></mxCell><mxCell id="dig" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;digester (Go)&lt;/b&gt;&lt;br&gt;đọc đầu chain định kỳ&lt;br&gt;xin Vault ký digest" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="358.4" y="1052.8" width="257.6" height="100.8" as="geometry"/></mxCell><mxCell id="vault" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Vault (dev) · Transit&lt;/b&gt;&lt;br&gt;key siem-digest (ed25519)&lt;br&gt;token chỉ được quyền sign" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="739.2" y="1052.8" width="268.8" height="100.8" as="geometry"/></mxCell><mxCell id="cfg" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Cấu hình và bí mật&lt;/b&gt;&lt;br&gt;.env, compose, envoy.yaml&lt;br&gt;policy .rego, realm export" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="56.0" y="1299.2" width="302.4" height="100.8" as="geometry"/></mxCell><mxCell id="ca" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;CA nội bộ&lt;/b&gt;&lt;br&gt;giữ khoá riêng của CA&lt;br&gt;ký chứng chỉ TLS cho service" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380.8" y="1299.2" width="302.4" height="100.8" as="geometry"/></mxCell><mxCell id="admin" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Quyền quản trị&lt;/b&gt;&lt;br&gt;Keycloak admin, Vault token&lt;br&gt;shell WSL, Docker daemon" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="705.6" y="1299.2" width="302.4" height="100.8" as="geometry"/></mxCell><mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;exitX=0.2294;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.8478;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="client" target="envoy"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=0.9412;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.7917;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="client" target="kc"><mxGeometry relative="1" as="geom