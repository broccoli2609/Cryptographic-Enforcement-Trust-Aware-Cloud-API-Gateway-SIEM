=&#x27;font-size:14px&#x27;&gt;Envoy&lt;/b&gt;&lt;br&gt;kết thúc TLS 1.3&lt;br&gt;gọi auth-svc (ext_authz)&lt;br&gt;xoá header, đặt X-User" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="56.0" y="375.2" width="257.6" height="123.2" as="geometry"/></mxCell><mxCell id="auth" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;auth-svc (Go)&lt;/b&gt;&lt;br&gt;kiểm JWT (SR-02)&lt;br&gt;kiểm DPoP (SR-04)&lt;br&gt;lỗi thì chặn (SR-11)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="358.4" y="375.2" width="257.6" height="123.2" as="geometry"/></mxCell><mxCell id="kc" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Keycloak&lt;/b&gt;&lt;br&gt;PKCE S256 (SR-03)&lt;br&gt;ký token · công bố JWKS&lt;br&gt;gắn cnf.jkt khi có DPoP" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="739.2" y="375.2" width="268.8" height="123.2" as="geometry"/></mxCell><mxCell id="orders" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;orders-api&lt;/b&gt;&lt;br&gt;kiểm owner_id (BOLA)&lt;br&gt;SR-06" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="56.0" y="632.8" width="257.6" height="100.8" as="geometry"/></mxCell><mxCell id="profile" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;profile-api&lt;/b&gt;&lt;br&gt;salary_band chỉ cho HR&lt;br&gt;SR-06" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="358.4" y="632.8" width="257.6" height="100.8" as="geometry"/></mxCell><mxCell id="opa" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;OPA / Rego&lt;/b&gt;&lt;br&gt;default allow := false&lt;br&gt;trả kèm policy_version" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="739.2" y="632.8" width="268.8" height="100.8" as="geometry"/></mxCell><mxCell id="vector" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Vector&lt;/b&gt;&lt;br&gt;bỏ token thô (SR-10)&lt;br&gt;nối hash chain (SR-09)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="56.0" y="907.2" width="257.6" height="100.8" as="geometry"/></mxCell><mxCell id="os" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;OpenSearch&lt;/b&gt;&lt;br&gt;lưu và tìm kiếm log&lt;br&gt;6 hunt query" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="358.4" y="907.2" width="257.6" height="100.8" as="geometry"/></mxCell><mxCell id="dig" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;digester (Go)&lt;/b&gt;&lt;br&gt;lấy hash cuối chuỗi&lt;br&gt;mỗi 5 phút" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="358.4" y="1052.8" width="257.6" height="100.8" as="geometry"/></mxCell><mxCell id="vault" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Vault Transit&lt;/b&gt;&lt;br&gt;ký digest bằng ed25519&lt;br&gt;khoá không export" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="739.2" y="1052.8" width="268.8" height="100.8" as="geometry"/></mxCell><mxCell id="cfg" valu