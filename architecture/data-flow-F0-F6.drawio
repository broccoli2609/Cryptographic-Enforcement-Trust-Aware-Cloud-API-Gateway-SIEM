<mxfile host="app.diagrams.net"><diagram id="trust-boundary" name="Trust boundary"><mxGraphModel dx="1064.0" dy="1456.0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1064.0" pageHeight="1456.0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="Data flow F0–F6: chỉ F1 và F2 đến từ Internet, các luồng còn lại chạy bên trong" style="text;html=1;whiteSpace=nowrap;fillColor=none;strokeColor=none;fontColor=#000000;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="33.6" y="25.2" width="980.0" height="30.8" as="geometry"/></mxCell><mxCell id="v2" value="Khung đứt nét = vùng tin cậy (trust boundary tuần 1) · nhãn xanh = mã luồng ở mục 5 đề bài · F3 không có trong lab" style="text;html=1;whiteSpace=nowrap;fillColor=none;strokeColor=none;fontColor=#555555;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="33.6" y="61.6" width="980.0" height="25.2" as="geometry"/></mxCell><mxCell id="zInternet" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="33.6" y="106.4" width="996.8" height="145.6" as="geometry"/></mxCell><mxCell id="v3" value="Internet — không tin cậy" style="text;html=1;whiteSpace=nowrap;fillColor=none;strokeColor=none;fontColor=#b85450;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50.4" y="114.8" width="504.0" height="30.8" as="geometry"/></mxCell><mxCell id="zGateway" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="33.6" y="330.4" width="604.8" height="190.4" as="geometry"/></mxCell><mxCell id="v4" value="Gateway (PEP)" style="text;html=1;whiteSpace=nowrap;fillColor=none;strokeColor=none;fon