# Sao file này thành .env rồi đổi mật khẩu:  cp .env.example .env
# File .env chứa bí mật nên KHÔNG được commit (đã có trong .gitignore).
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=doi-mat-khau-nay

# Mật khẩu chung của 4 user test trong realm topic09 (alice, bob, carol, dave) — tuần 3.
# Sinh ngẫu nhiên:  openssl rand -base64 24 | tr -d "/+=" | cut -c1-24
LAB_USER_PASSWORD=doi-mat-khau-nay-nua

# Khoá HMAC-SHA256 để Vector giả danh định danh (sub, aud) trước khi vào SIEM (tài sản #14) — tuần 8.
# Lộ khoá này = đoán ngược được principal_hash bằng cách băm thử danh sách user. Đổi khoá thì
# hash mới không còn nối được với sự kiện cũ.
# Sinh ngẫu nhiên (32 byte = 64 ký tự hex):  openssl rand -hex 32
SIEM_HMAC_KEY=doi-thanh-64-ky-tu-hex
